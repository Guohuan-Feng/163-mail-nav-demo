# 将此文件复制为 config.env，再填写自己的 163 邮箱和“IMAP 授权码”。
# 不要把 config.env 发给他人，也不要填写网页登录密码。

IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=your_163_mail@163.com
IMAP_AUTH_CODE=replace_with_your_163_imap_authorization_code

# 检索最近多少天的 INBOX 邮件；手动运行时可用 --days 覆盖。
LOOKBACK_DAYS=7

# 演示版默认只输出前 5 条规范记录；设为 0 表示不限制。
MAX_ROWS=5

# 留空则不过滤主题；例如：SUBJECT_KEYWORD=净值
SUBJECT_KEYWORD=

# 均可使用相对路径（相对于本脚本目录）。
DOWNLOAD_DIR=downloads
OUTPUT_DIR=output

# 单个附件的大小上限，避免误处理超大文件。
MAX_ATTACHMENT_MB=20
